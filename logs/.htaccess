# Deny direct web access to operational logs.
# improvementproposal.md F-07: this directory holds server paths, product data
# and queue contents that must never be served as static content.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
